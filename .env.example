# Copy to .env for `docker compose`. Compose refuses to start without SECRET_KEY_BASE.
# Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# Optional. Defaults shown.
POSTGRES_PASSWORD=ftf_assessment_dev
RAILS_MAX_THREADS=5
WIKIPEDIA_CACHE_TTL_SECONDS=3600
WIKIPEDIA_OPEN_TIMEOUT=3
WIKIPEDIA_READ_TIMEOUT=5
